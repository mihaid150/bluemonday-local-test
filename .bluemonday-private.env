# Local email preview. With "log", complete emails are written to the
# application container's storage/logs/laravel.log instead of being sent.
MAIL_MAILER='log'
MAIL_LOG_CHANNEL='mail'
MAIL_FROM_ADDRESS='no-reply@bluemonday.test'
MAIL_FROM_NAME='Blue Monday'

# Messaging. For production-scale processing use Redis queues and a private
# S3-compatible disk. The private environment keeps safe synchronous fallbacks.
QUEUE_CONNECTION='sync'
BROADCAST_DRIVER='null'
# Set both only when a Redis-backed Laravel Echo Server/Soketi gateway exists.
MIX_ECHO_ENABLED='false'
MIX_ECHO_HOST='http://localhost:6001'
MESSAGE_PAGE_SIZE='30'
MESSAGE_MAX_ATTACHMENT_KB='10240'
MESSAGE_FILESYSTEM_DISK='local'
MESSAGE_RETENTION_DAYS='730'
MESSAGE_ANTIVIRUS_COMMAND=''
MESSAGE_ALLOW_WITHOUT_ANTIVIRUS='false'

