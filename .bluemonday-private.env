# ---------------------------------------------------------------------------
# LOCAL TEST ENVIRONMENT
#
# Everything below overrides the values above (last assignment wins). It points
# the stack at the generated test dataset and at its own containers, volumes
# and ports, so this environment can run alongside the private one without
# touching its data.
# ---------------------------------------------------------------------------

# Generated dataset instead of the production dump. "raw" applies the file
# directly because it carries its own schema and migration state.
DUMP_FILE='sql_test_dump.sql'
DUMP_IMPORT_MODE='raw'
DUMP_IMPORTER='import-dump.php'
FORCE_IMPORT='0'

# TEST unlocks the date-shift question when provisioning: keep the dump's
# original dates, or move them all to now with the intervals between them
# intact. Set to PROD to disable the question and never rewrite dates.
ENVIRONMENT_TYPE='TEST'
# ask | yes | no -- "ask" prompts when a terminal is attached.
SHIFT_DATES='ask'

# The name must carry a Docker Hub namespace. A bare "bluemonday-local:latest"
# resolves to docker.io/library/... -- the official-images namespace -- and any
# push is denied no matter who is logged in.
IMAGE_SOURCE='pull'
IMAGE_NAME='mipeda150/bluemonday-private:latest'
IMAGE_WORKFLOW_PROMPT='false'

# Dedicated containers, volumes and network.
NETWORK_NAME='bm-local-net'
DB_CONTAINER='bm-local-db'
DB_VOLUME='bm-local-db-data'
APP_CONTAINER='bm-local-app'
WORKER_CONTAINER='bm-local-worker'
SCHEDULER_CONTAINER='bm-local-scheduler'
REDIS_CONTAINER='bm-local-redis'
REDIS_VOLUME='bm-local-redis-data'
REDIS_HOST='bm-local-redis'
MINIO_CONTAINER='bm-local-minio'
MINIO_VOLUME='bm-local-minio-data'
CLAMAV_CONTAINER='bm-local-clamav'
CLAMAV_VOLUME='bm-local-clamav-data'
CLAMAV_HOST='bm-local-clamav'
ECHO_CONTAINER='bm-local-echo'
AWS_ENDPOINT='http://bm-local-minio:9000'

# Ports that do not collide with the private environment (8084, 9000, 9001).
APP_PORT='8085'
APP_URL='http://localhost:8085'
MINIO_API_PORT='9010'
MINIO_CONSOLE_PORT='9011'

# Local testing benefits from visible errors.
APP_DEBUG='true'
